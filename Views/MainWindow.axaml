<Window x:Class="SNESMiniLuaCompiler.Views.MainWindow"
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:model="using:SNESMiniLuaCompiler.Models"
		xmlns:view="using:SNESMiniLuaCompiler.Views"
		xmlns:vm="using:SNESMiniLuaCompiler.ViewModels"
		xmlns:res="using:SNESMiniLuaCompiler.Resources"
		Title="(S)NES Mini - Lua Compiler"
		d:DesignWidth="590"
		d:DesignHeight="336"
		x:CompileBindings="true"
		x:DataType="vm:MainWindowViewModel"
		CanResize="False"
		CanMinimize="False"
		Width="590"
		Height="336"
		WindowStartupLocation="CenterScreen"
		mc:Ignorable="d">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>


	<Window.Styles>
		<Style Selector="TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontFamily" Value="Default" />
		</Style>
		<!--		<Style Selector="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="MaxHeight" Value="90" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>-->
		<Style Selector="RadioButton">
			<Setter Property="Theme" Value="{DynamicResource PureCardRadioButton}" />
		</Style>
	</Window.Styles>

	<Grid>
		<TextBlock Text="(S)NES Mini - Lua Compiler"
				   FontSize="30"
				   FontWeight="Bold"
				   HorizontalAlignment="Center"
				   Margin="0,30,0,0"
				   VerticalAlignment="Top"/>
		<Image Source="avares://SNESMiniLuaCompiler/Assets/app_bg.png"
			   Stretch="UniformToFill"
			   IsHitTestVisible="False"/>
		<!--<ListBox ItemsSource="{Binding People}" />-->
		<Grid RowDefinitions="100,100,110,Auto">
			<!-- First row: fixed height -->
			<StackPanel Grid.Row="0"
						Orientation="Horizontal"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="0,10"
						Spacing="20">
				<!--<TextBlock Text="Row 3 (fixed height)"/>-->


				<ToggleSwitch
				Theme="{DynamicResource IconBorderlessToggleSwitch}"
				Command="{Binding ToggleThemeCommand}"
				OnContent="{StaticResource SemiIconSun}"
				OffContent="{StaticResource SemiIconMoon}" />
			</StackPanel>
			<!-- Second row: stretch height -->
			<StackPanel
			Grid.Row="1"
			Orientation="Horizontal"
			Spacing="20"
			Name="mainPanel"
			HorizontalAlignment="Center"
			VerticalAlignment="Stretch">
				<ItemsControl x:Name="items" ItemsSource="{Binding ConsoleList}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<RadioButton Command="{Binding DataContext.SelectConsoleCommand, ElementName=items}"
										 CommandParameter="{Binding SystemModel}" IsChecked="{Binding IsChecked}">
								<RadioButton.Content>
									<StackPanel>
										<Image Source="{Binding ImagePath}"
											   RenderOptions.BitmapInterpolationMode="HighQuality"/>
										<TextBlock HorizontalAlignment="Center" Text="{Binding Name}" />
										<TextBlock HorizontalAlignment="Center" Text="{Binding Region}" />
									</StackPanel>
								</RadioButton.Content>
							</RadioButton>
							<!--<Button
							Command="{Binding DataContext.SelectConsoleCommand, ElementName=items}"
							CommandParameter="{Binding SystemModel}">
							<Button.Content>
							<StackPanel Orientation="Vertical" VerticalAlignment="Center">
							<Image Source="{Binding ImagePath}" />
							<TextBlock HorizontalAlignment="Center" Text="{Binding Name}" />
							<TextBlock HorizontalAlignment="Center" Text="{Binding Region}" />
							</StackPanel>
							</Button.Content>
							</Button>-->
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</StackPanel>

			<!-- Third row: fixed height -->
			<StackPanel Grid.Row="2"
						Orientation="Horizontal"
						HorizontalAlignment="Center"
						Spacing="100">
				<Button
				Name="btn_decrypt"
				Width="170"
				Height="45"
				Content="Decrypt"
				Theme="{DynamicResource OutlineButton}"
				Classes="Warning"
				VerticalContentAlignment="Center"
				IsEnabled="{Binding IsDecodeButtonEnabled}"
				Click="DecryptButton_Click"/>

				<Button
				Name="btn_encrypt"
				Width="170"
				Height="45"
				Theme="{DynamicResource OutlineButton}"
				Classes="Warning"
				VerticalContentAlignment="Center"
				IsEnabled="{Binding IsRecodeButtonEnabled}"
				Click="EncryptButton_Click">
					Encode
				</Button>

			</StackPanel>
			<!-- Fourth row: fixed to bottom -->
			<Border
			Grid.Row="3"
			BorderBrush="#29292d"
			BorderThickness="0,1,0,0"
			VerticalAlignment="Bottom">
				<Grid Name="footer" Classes="footer" ColumnDefinitions="Auto,*" VerticalAlignment="Center"
					  Margin="10,0,10,0">
					<StackPanel Grid.Column="0"
								Orientation="Horizontal"
								HorizontalAlignment="Center"
								Spacing="5">
						<TextBlock Text="Status:" VerticalAlignment="Center"/>
						<!--<TextBlock Grid.Column="1" Name="status" Text="..." VerticalAlignment="Center"/>-->
						<TextBlock  Margin="0 5" x:Name="message" VerticalAlignment="Center">Ready...</TextBlock>
					</StackPanel>
					<TextBlock Grid.Column="2"
							   Text="{Binding AppVersion}"
							   HorizontalAlignment="Right"
							   VerticalAlignment="Center"/>
				</Grid>
			</Border>
		</Grid>

	</Grid>

</Window>
